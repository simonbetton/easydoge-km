namespace easydoge_km {
  enum Network {
    "mainnet",
    "testnet",
    "regtest"
  };

  enum Language {
    "english",
    "simplifiedChinese",
    "traditionalChinese",
    "czech",
    "french",
    "italian",
    "japanese",
    "korean",
    "portuguese",
    "spanish"
  };

  dictionary MnemonicOptions {
    Language language;
    u16 word_count;
  };

  dictionary GeneratedMnemonic {
    string phrase;
    Language language;
    u16 word_count;
  };

  dictionary Xpriv {
    Network network;
    string encoded;
  };

  dictionary Xpub {
    Network network;
    string encoded;
  };

  dictionary AccountKeySet {
    Network network;
    u32 account;
    string account_path;
    Xpriv xpriv;
    Xpub xpub;
  };

  dictionary PathAddress {
    Network network;
    string path;
    string public_key_hex;
    string address;
  };

  dictionary ExtendedKeyInfo {
    Network network;
    u8 depth;
    string parent_fingerprint_hex;
    u32 child_number;
    string? public_key_hex;
    boolean private_key_redacted;
  };

  dictionary WifInfo {
    Network network;
    string public_key_hex;
    string address;
    boolean compressed;
  };

  dictionary MultisigDescriptor {
    Network network;
    u8 threshold;
    u8 cosigner_count;
    string child_path;
    boolean sorted;
    sequence<string> public_keys_hex;
    string redeem_script_hex;
    string p2sh_address;
  };

  dictionary MessageSignature {
    Network network;
    string address;
    string signature_base64;
  };

  dictionary SignedTransaction {
    Network network;
    string signed_tx_hex;
  };

  enum SigningInputKind {
    "p2pkh",
    "p2shMultisig"
  };

  dictionary SigningEnvelopeInput {
    u64 input_index;
    SigningInputKind kind;
    string script_pubkey_hex;
    string? redeem_script_hex;
    u32 sighash_type;
    u64? previous_output_value_koinu;
    u8? multisig_threshold;
    sequence<string> multisig_public_keys_hex;
  };

  dictionary SigningEnvelopeSignature {
    u64 input_index;
    string public_key_hex;
    string signature_hex;
  };

  dictionary SigningEnvelope {
    u8 version;
    Network network;
    string unsigned_tx_hex;
    sequence<SigningEnvelopeInput> inputs;
    sequence<SigningEnvelopeSignature> signatures;
  };

  enum UtxoSignerKind {
    "wif",
    "xprivDerivation"
  };

  dictionary UtxoSigner {
    UtxoSignerKind kind;
    string? wif;
    Xpriv? xpriv;
    string? derivation_path;
  };

  dictionary SpendableUtxo {
    string txid;
    u32 vout;
    u64 previous_output_value_koinu;
    string script_pubkey_hex;
    SigningInputKind kind;
    string? redeem_script_hex;
    u8? multisig_threshold;
    sequence<string> multisig_public_keys_hex;
    sequence<UtxoSigner> signers;
    boolean manually_selected;
  };

  enum TransactionOutputKind {
    "address",
    "opReturn",
    "expertRawScript"
  };

  dictionary TransactionOutput {
    TransactionOutputKind kind;
    u64 value_koinu;
    string? address;
    string? op_return_data_hex;
    string? script_hex;
  };

  dictionary FeePolicy {
    u64 fee_rate_koinu_per_kb;
    u64 dust_threshold_koinu;
  };

  enum CoinSelectionStrategy {
    "minInputs",
    "smallestFirst",
    "largestFirst",
    "manualSelectedInputs"
  };

  dictionary ChangeDestination {
    string? address;
    Xpriv? xpriv;
    string? derivation_path;
  };

  dictionary TransactionOptions {
    i32 version;
    u32 lock_time;
    u32 sequence;
    u32 sighash_type;
  };

  dictionary ComposeTransactionRequest {
    Network network;
    sequence<SpendableUtxo> utxos;
    sequence<TransactionOutput> outputs;
    FeePolicy fee_policy;
    CoinSelectionStrategy coin_selection;
    ChangeDestination? change;
    TransactionOptions options;
  };

  dictionary AuditedInput {
    string txid;
    u32 vout;
    u64 previous_output_value_koinu;
    string script_pubkey_hex;
    SigningInputKind kind;
  };

  dictionary SkippedInput {
    string txid;
    u32 vout;
    u64 previous_output_value_koinu;
    string reason;
  };

  dictionary ComposeTransactionResult {
    Network network;
    sequence<AuditedInput> selected_inputs;
    sequence<SkippedInput> skipped_inputs;
    u64 input_total_koinu;
    u64 spend_output_total_koinu;
    u64 change_amount_koinu;
    string? change_address;
    string? change_script_pubkey_hex;
    u64 fee_koinu;
    u64 estimated_size_bytes;
    u64? actual_size_bytes;
    boolean dust_change_folded_into_fee;
    string unsigned_tx_hex;
    string? signed_tx_hex;
    SigningEnvelope? signing_envelope;
  };

  GeneratedMnemonic generate_mnemonic(MnemonicOptions options);
  boolean validate_mnemonic(string phrase, Language language);
  string mnemonic_to_seed_hex(string phrase, string? passphrase, Language language);
  AccountKeySet account_xpriv_from_mnemonic(string phrase, string? passphrase, Language language, Network network, u32 account);
  Xpriv derive_path_from_xpriv(Xpriv xpriv, string path);
  Xpub derive_path_from_xpub(Xpub xpub, string path);
  Xpub xpub_from_xpriv(Xpriv xpriv);
  PathAddress derive_address_from_xpriv(Xpriv xpriv, string path);
  PathAddress derive_address_from_xpub(Xpub xpub, string path);
  ExtendedKeyInfo inspect_xpriv(Xpriv xpriv);
  ExtendedKeyInfo inspect_xpub(Xpub xpub);
  string wif_from_xpriv(Xpriv xpriv);
  WifInfo address_from_wif(Network network, string wif);
  boolean validate_address(Network network, string address);
  MultisigDescriptor create_multisig_descriptor(Network network, u8 threshold, sequence<Xpub> cosigner_xpubs, string child_path, boolean sorted);
  MessageSignature sign_message(Network network, string wif, string message);
  boolean verify_message(Network network, string address, string signature_base64, string message);
  SignedTransaction sign_p2pkh_transaction(Network network, string unsigned_tx_hex, u64 input_index, string script_pubkey_hex, string wif, u32 sighash_type);
  SigningEnvelope sign_signing_envelope(SigningEnvelope envelope, string wif);
  SigningEnvelope combine_signing_envelopes(sequence<SigningEnvelope> envelopes);
  SignedTransaction finalize_signing_envelope(SigningEnvelope envelope);
  ComposeTransactionResult compose_and_sign_transaction(ComposeTransactionRequest request);
};
